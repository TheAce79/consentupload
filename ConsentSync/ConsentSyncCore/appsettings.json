{
  "//Comments": [
    "═══════════════════════════════════════════════════════════",
    "ConsentSync - Unified Configuration for All 3 Phases",
    "═══════════════════════════════════════════════════════════",
    "To run specific phases, set 'Enabled' to true/false",
    "The main Program.cs will orchestrate all enabled phases",
    "─────────────────────────────────────────────────────────",
    "PRE-PHASE: CSV Processing (StudentCsvProcessor)",
    "─────────────────────────────────────────────────────────"
  ],

  "BaseDirectory": "C:\\PHIS",

  "SchoolContext": {
    "_Comment": "Current school context for processing",
    "SchoolName": "Antonine-Maillet",
    "Grade": "7",
    "SchoolYear": "2025-2026"
  },


  "BulkPdfExtraction": {
    "_Comment": "STANDALONE: Process bulk PDFs OR scanned PDFs automatically",
    "Enabled": true,
    "Description": "Automatically detects PDF type (bulk vs scanned) and processes accordingly",

    "BasePdfPath": "{BaseDirectory}\\{SchoolName}\\Grade {Grade}\\Pdf",

    "InputBulkFolder": "1_Input_Bulk",
    "InputScannedFolder": "2_Input_Scanned",
    "OutputReadyFolder": "3_Output_Ready",
    "FileRoseFolder": "4 FileRose Extraction",
    "Duplicate_Client": "5_Duplicate",
    "ErrorFolder": "6_Error",
    "ArchiveFolder": "7_Archive",

    "PagesPerConsent": 1,
    "StartPage": 1,
    "AutoDetectNames": true,
    "NamingFormat": "{ID}_{LastName}_{FirstName}_consent",
    "OverwriteExisting": false,
    "MoveToArchiveAfterProcessing": true,
    "MoveErrorPdfsToErrorFolder": true
  },

  "CsvWorkspace": {
    "_Comment": "CSV folder structure — per grade, data-entry friendly",
    "BaseCsvPath": "{BaseDirectory}\\{SchoolName}\\Grade {Grade}\\Csv",

    "InputFolder": "1_Input Csv",
    "OutputFolder": "2_Output Csv",

    "ConsentCsvSubFolder": "1 Consent Csv",
    "ProcessedCsvSubFolder": "1 Processed Csv",
    "UploadCsvSubFolder": "2 Upload Csv"
  },


  "CsvProcessing": {
    "SaveProgressEveryNRecords": 5,

    "InputCsvFileName": "immunizations.csv",
    "OutputCsvFileName": "immunizations_processed.csv",

    "DateOfBirthColumn": "Date of Birth",
    "DateFormat": "yyyy-MM-dd",
    "InputDateFormats": [
      "dd/MM/yyyy",
      "MM/dd/yyyy",
      "yyyy-MM-dd",
      "dd-MM-yyyy",
      "MM-dd-yyyy",
      "d/M/yyyy",
      "M/d/yyyy"
    ],

    "LastNameColumn": "Last Name",
    "FirstNameColumn": "First Name",
    "ClientIdColumn": "ClientId",

    "AdditionalColumns": {
      "ClientId": null,
      "IsFileRoseDefault": false,
      "ClientIdStatus": 0,
      "BestMatch": ""
    },

    "EncodingsToTry": [
      {
        "Name": "UTF-8",
        "CodePage": "utf-8",
        "Priority": 1
      },
      {
        "Name": "UTF-8 with BOM",
        "CodePage": "utf-8",
        "UseBOM": true,
        "Priority": 2
      },
      {
        "Name": "Windows-1252 (ANSI)",
        "CodePage": "1252",
        "Priority": 3
      },
      {
        "Name": "ISO-8859-1 (Latin-1)",
        "CodePage": "iso-8859-1",
        "Priority": 4
      },
      {
        "Name": "System Default",
        "CodePage": "default",
        "Priority": 5
      }
    ]
  },



  "Phase1": {
    "_Comment": "PHASE 1: Search Client IDs on PHIS",
    "Enabled": false,
    "Description": "Search PHIS by Date of Birth and find Client IDs",

    "Processing": {
      "FilterByStatus": "NotProcessed",
      "SaveProgressEveryNRecords": 5,
      "MaxRetries": 3,
      "DelayBetweenRetriesMs": 2000
    }
  },

  "PhisWorkspace": {
    "_Comment": "SHARED: Single working directory for Phase 2 → PrePhase 3 → Phase 3 pipeline",
    "BasePath": "{BaseDirectory}\\{SchoolName}\\Grade {Grade}\\Phis",
    "ToUploadFolder": "1_To_Upload",
    "ErrorFolder": "2_Error",
    "ConsentUploadSubFolder": "1 Consent Upload",
    "FileRoseUploadSubFolder": "2 File Rose Upload"
  },

  "Phase2": {
    "_Comment": "PHASE 2: Process and Validate Consent PDFs",
    "Enabled": false,
    "Description": "Validate extracted PDFs against student CSV",

    "Download": {
      "MaxDownloadRetries": 3,
      "DelayBetweenDownloadsMs": 1000
    },

    "PdfProcessing": {
      "ValidateNamesBeforeRename": true,
      "SplitMultiPagePdfs": true,
      "FileRosePageThreshold": 1,
      "DebugMode": false,
      "DebugOutputDir": "{BaseDirectory}\\{SchoolName}\\Grade {Grade}\\Debug",
      "UseFuzzyMatching": true,
      "ReadNamesFromFilename": true
    },

    "Output": {
      "ValidationResultsCsv": "Validation_Results.csv",
      "UploadCsv": "Upload_to_PHIS.csv"
    },

    "VaccineTypes": {
      "Grade7": [ "HPV9", "Tdap" ],
      "Grade9": [ "MenCACYW135" ]
    }
  },

  "PrePhase3": {
    "_Comment": "PRE-PHASE 3: Validate and Prepare PDFs for Upload",
    "Enabled": false,
    "Description": "Process validated PDFs and generate Upload_to_PHIS.csv",
    "ValidationCsvFileName": "Validation_Results.csv",
    "MinMatchScoreToAutoAccept": 90.0,

    "AntigenMapping": {
      "ConsentHPV9": "HPV-9",
      "ConsentTdap": "Tetanus (T)",
      "ConsentMenCACYW135": "Men-C-ACYW-135"
    }
  },


  "Phase3": {
    "_Comment": "PHASE 3: Upload Documents to PHIS",
    "Enabled": false,
    "Description": "Upload renamed consent PDFs to PHIS client records",

    "Input": {
      "UploadCsvFileName": "Upload_to_PHIS.csv"
    },

    "Upload": {
      "MaxUploadRetries": 3,
      "DelayBetweenUploadsMs": 2000,
      "WaitAfterUploadMs": 1500,
      "VerifyUploadSuccess": true
    },
    "Testing": {
      "Enabled": true,
      "TestClientIds": [ "106467", "1066457", "325041" ],
      "MaxRecordsToProcess": 0
    },
    "FileRose": {
      "FileRoseEnabled": true,
      "UseCustomFileRosePerVaccine": false,
      "FileRoseByVaccine": {
        "HPV9": "{BaseDirectory}\\FileRose\\FileRose_HPV9_{SchoolYear}.pdf",
        "Tdap": "{BaseDirectory}\\FileRose\\FileRose_Tdap_{SchoolYear}.pdf",
        "MenCACYW135": "{BaseDirectory}\\FileRose\\FileRose_MenC_{SchoolYear}.pdf"
      }
    },

    "Navigation": {
      "ImmunizationServiceUrl": "/phsdsm/ConsentDirectiveWeb/pages/consent/consentForImms.xhtml",
      "ImmunizationServicePageTitle": "Consent Directives - Immunization Service",
      "PageTitleElementId": "layout-toolbar-title",
      "ConsentDirectivesMenuId": "menu:comibmpdcephsimmunization_ConsentDirectives",
      "ImmunizationServiceMenuId": "menu:comibmpdcephsimmunization_ImmunizationService",
      "DocumentsSectionId": "documents-tab",
      "UploadButtonId": "upload-btn",
      "DocumentTitleFieldId": "doc-title",
      "DocumentDescriptionFieldId": "doc-description"
    },

    "Output": {
      "CompletedCsvFileName": "Upload_to_PHIS_completed.csv"
    }
  },




  "PhisAutomation": {
    "_Comment": "SHARED: PHIS Automation (Phase 1 & 3)",
    "LoginUrl": "https://phisisp.gnb.ca/phsdsm/",
    "SearchUrl": "https://phisisp.gnb.ca/phsdsm/ClientWeb/pages/search/clientSearch.xhtml",

    "Authentication": {
      "Username": "",
      "Password": "",
      "ManualLoginMode": true,
      "ManualLoginWaitSeconds": 300
    },

    "Session": {
      "SessionTimeoutMinutes": 20,
      "SessionRefreshEnabled": true,
      "RefreshBufferMinutes": 2
    },

    "Timing": {
      "WebDriverWaitSeconds": 15,
      "DelayBetweenSearchesMs": 1000,
      "PageLoadDelayMs": 2000,
      "AjaxWaitMs": 1000
    },

    "ColumnHeaders": {
      "ClientId": "Client ID",
      "FirstName": "First Name",
      "LastName": "Last Name",
      "Medicare": "Health Card Number",
      "DateOfBirth": "Date of Birth"
    },

    "FuzzyMatching": {
      "Enabled": true,
      "SingleResultThreshold": 75.0,
      "MultipleResultsThreshold": 85.0,
      "ManualReviewThreshold": 70.0,
      "LastNameWeight": 0.6,
      "FirstNameWeight": 0.4,
      "IgnoreHyphensInComparison": true,
      "IgnoreSpacesInComparison": true,
      "TreatCompoundNamesAsPartialMatch": true,
      "TreatSpaceSeparatedNamesAsCompound": true,
      "MinimumCompoundMatchRatio": 0.5,

      "_Comment_CompoundNames_Help": [
        "TreatCompoundNamesAsPartialMatch: Enable compound name matching (e.g., 'Jean-Marie' vs 'Jean')",
        "TreatSpaceSeparatedNamesAsCompound: Treat space-separated names as compound (e.g., 'Mohammad Jaabir' vs 'Jaabir')",
        "CompoundNameMatchScore: Match score for compound names (0-100, default: 95.0)",
        "MinimumCompoundMatchRatio: Minimum ratio of matching parts for multi-part compounds (0.0-1.0, default: 0.5)"
      ],

      "CompoundNameMatchScore": 0.95,
      "UseMedicareNumberAsConfirmation": true,
      "MedicareNumberBoostScore": 20.0
    }
  },

  "ChromeDriver": {
    "_Comment": "SHARED: Chrome WebDriver Configuration",
    "UsePortableChrome": false,
    "PortableChromePath": "",
    "ChromeDriverPath": "",
    "UseDebuggerMode": false,
    "DebuggerPort": 9222,

    "Options": {
      "StartMaximized": true,
      "DisableNotifications": true,
      "DisablePopupBlocking": true,
      "HideAutomationIndicators": true,
      "Headless": false
    },

    "Download": {
      "DefaultDownloadChromeDirectory": "{BaseDirectory}\\DefaultChromeDir"
    }
  },

  "PdfExtraction": {
    "_Comment": "SHARED: PDF Processing (Phase 2)",
    "LastNameKeywords": [ "FAMILLE", "NOM", "SURNAME" ],
    "FirstNameKeywords": [ "PRÉNOM", "PRENOM", "GIVEN" ],
    "ExcludeKeywords": [ "PRÉFÉRÉ", "PREFERRED", "DATE", "SEXE", "GENDER", "SEX" ],
    "FieldLabelWords": [
      "FIRST",
      "LAST",
      "NAME",
      "PREFERRED",
      "NOM",
      "PRÉNOM",
      "PRENOM",
      "DE",
      "FAMILLE",
      "GIVEN",
      "SURNAME",
      "LEGAL",
      "GUARDIAN",
      "PARENT",
      "TEACHER",
      "HOMEROOM",
      "SCHOOL",
      "GRADE"
    ],
    "SearchRange": 15,
    "MinNameLength": 2,

    "LastNamePatterns": [
      {
        "Words": [ "LAST", "NAME" ],
        "Language": "English"
      },
      {
        "Words": [ "NOM", "DE", "FAMILLE" ],
        "Language": "French"
      },
      {
        "Words": [ "SURNAME" ],
        "Language": "English"
      },
      {
        "Words": [ "NOM" ],
        "Language": "French"
      }
    ],

    "FirstNamePatterns": [
      {
        "Words": [ "FIRST", "NAME" ],
        "Language": "English"
      },
      {
        "Words": [ "PRÉNOM" ],
        "Language": "French"
      },
      {
        "Words": [ "PRENOM" ],
        "Language": "French"
      },
      {
        "Words": [ "GIVEN", "NAME" ],
        "Language": "English"
      }
    ],

    "PreferredNamePatterns": [
      {
        "Words": [ "PREFERRED", "FIRST", "NAME" ],
        "Language": "English"
      },
      {
        "Words": [ "PRÉNOM", "PRÉFÉRÉ" ],
        "Language": "French"
      }
    ]
  },


  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ConsentSync": "Debug",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "Enabled": true,
      "UseColoredOutput": true,
      "ShowTimestamps": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss"
    },
    "File": {
      "Enabled": true,
      "LogPath": "{BaseDirectory}\\Logs",
      "LogFileName": "ConsentSync_{Date}.log",
      "MaxFileSizeMB": 10,
      "RetainDays": 30,
      "MinimumLevel": "Information"
    }
  }



}